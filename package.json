{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "serve": "cd public && php -d post_max_size=256M -d upload_max_filesize=256M -S 127.0.0.1:8010 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php",
        "dev": "vite",
        "queue": "php artisan queue:work --tries=1",
        "start": "concurrently -n server,vite,queue \"npm run serve\" \"npm run dev\" \"npm run queue\"",
        "build": "vite build"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "sass": "^1.105.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@casl/ability": "^7.0.1",
        "@casl/vue": "^3.0.1",
        "@mdi/font": "^7.4.47",
        "ofetch": "^1.5.1",
        "pinia": "^2.3.1",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.43",
        "vue-router": "^4.6.4",
        "vuedraggable": "^4.1.0",
        "vuetify": "^3.13.5",
        "yup": "^1.7.1"
    }
}
